<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="星愿卡 NTAG215 读取"
        android:textColor="@android:color/black"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#E8F1EA"
        android:padding="12dp"
        android:text="点击读取后贴卡"
        android:textColor="#174C2B" />

    <Button
        android:id="@+id/read_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="读取 NTAG215 内容" />

    <Button
        android:id="@+id/copy_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="复制 URL" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F4F4F1"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="等待操作"
            android:textColor="@android:color/black"
            android:textIsSelectable="true" />
    </ScrollView>

    <Button
        android:id="@+id/open_nfc_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开系统 NFC 设置" />
</LinearLayout>
