<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".nfc.Ntag424DnaTestActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NTAG 424 DNA"
            android:textColor="@android:color/black"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="芯片检测与受控 SDM 配置测试"
            android:textColor="#555555"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ntag424_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E8F1EA"
            android:padding="14dp"
            android:text="正在检查 NFC 状态"
            android:textColor="#174C2B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ntag424_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="220dp"
            android:background="#F4F4F1"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="@string/ntag424_waiting_for_tag"
            android:textColor="@android:color/black"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/ntag424_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="HTTPS URL"
            android:inputType="textUri"
            android:maxLines="4"
            android:text="https://wdb-applink.weidian.com?targetUrl=weidianbuyer%3A%2F%2Fwdb%2Fnfc%3Fversion%3D1%26encryptId%3D1zGuNzbVWQ8Fq3j87uVAupVruQ3M9QlK8%2Fu6SgG9Z8hpxD58fnZIHDx5bBkGbcUB" />

        <EditText
            android:id="@+id/ntag424_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Android package name"
            android:inputType="text"
            android:maxLines="1"
            android:text="com.koudai.weidian.buyer" />

        <Button
            android:id="@+id/write_ntag424_ndef"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="写入 URL + pkg 到 NDEF (File 02)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="普通贴卡仅执行只读检测。写入 NDEF、开启 SDM、关闭 SDM、增加写保护、移除写保护是五个独立的一次性操作，互不夹带其他配置变化。Demo 的 AppKey 0/1/2 使用同一份 16 字节全零密钥值，但各 Key 编号的协议角色不变；这些操作都不会修改密钥。"
            android:textColor="#8A3D00"
            android:textSize="13sp" />

        <Button
            android:id="@+id/clear_ntag424_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="清空结果，等待再次贴卡" />

        <Button
            android:id="@+id/enable_sdm_zero_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#B3261E"
            android:text="使用全零 Key 0 开启测试卡 SDM"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/disable_sdm_zero_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关闭 NDEF (File 02) SDM" />

        <Button
            android:id="@+id/enable_ntag424_write_protection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="增加 File 02 写保护（Demo Key 0）" />

        <Button
            android:id="@+id/disable_ntag424_write_protection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="移除 File 02 写保护（恢复 Free）" />

        <EditText
            android:id="@+id/ntag424_file03_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="File 03 测试文本（最多 126 bytes UTF-8）"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:text="NTAG424 File03 demo" />

        <Button
            android:id="@+id/write_ntag424_file03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="写入 Proprietary File 03（Demo Key 3）" />

        <Button
            android:id="@+id/read_ntag424_file03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="读取 Proprietary File 03（Demo Key 2）" />

        <Button
            android:id="@+id/open_nfc_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开系统 NFC 设置" />

    </LinearLayout>
</ScrollView>
