<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="星愿卡 NTAG215 写入"
        android:textColor="@android:color/black"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#E8F1EA"
        android:padding="12dp"
        android:text="选择 JSON 配置后点击写入"
        android:textColor="#174C2B" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/record_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/current_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="尚未选择配置"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/write_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="写入所选 URL 和包名" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F4F4F1"
                android:minHeight="120dp"
                android:padding="12dp"
                android:text="等待操作"
                android:textIsSelectable="true" />

            <LinearLayout
                android:id="@+id/config_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/open_nfc_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开系统 NFC 设置" />
</LinearLayout>
