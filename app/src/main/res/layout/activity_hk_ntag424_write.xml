<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="星愿卡生产写入"
        android:textColor="@android:color/black"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#E8F1EA"
        android:padding="12dp"
        android:text="选择写入后贴卡"
        android:textColor="#174C2B"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="选择写卡数据"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/record_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/clear_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="清除选择" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="所选数据"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/current_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#F4F4F1"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@android:color/black"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/write_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#176B3A"
                android:text="写入所选数据"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/disable_sdm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="使用所选 Key 0 关闭 SDM" />

            <Button
                android:id="@+id/clear_ndef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="使用所选 Key 0 清空 NDEF (File 02)" />

            <Button
                android:id="@+id/reset_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="使用所选数据重置 Key 0/1/2 为初始状态" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="操作结果"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#F4F4F1"
                android:fontFamily="monospace"
                android:minHeight="180dp"
                android:padding="12dp"
                android:textColor="@android:color/black"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/open_nfc_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="打开系统 NFC 设置" />

            <LinearLayout
                android:id="@+id/config_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
